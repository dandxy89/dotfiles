#!/bin/bash
# Print today's date (YYYY-MM-DD); 'gendate h N' prefixes a markdown heading,
# e.g. 'gendate h 3' -> '### 2023-03-29'

if [[ $# -gt 0 ]]; then
	if [[ "$1" != "h" || $# -ne 2 ]]; then
		echo "Usage: gendate h 2 to generate with markdown heading ##"
		exit 1
	fi
	printf '#%.0s' $(seq "$2")
	echo " $(date +%F)"
	exit 0
fi

date +%F
