[user]
	name = Dan Dixey
[init]
    defaultBranch = main
[core]
	autocrlf = input
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto
[alias]
	c = commit
	s = status
	lg = log --oneline
	last = log -1 HEAD
	cl = log -p -- ':(exclude)Cargo.lock'
	f = push --force-with-lease
    pl = pull --rebase
    ss = "!f() { git stash show stash^{/$*} -p; }; f"
	sa = "!f() { git stash apply stash^{/$*}; }; f"
	sl = stash list
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
    br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
    undo = reset --soft HEAD~1
    contrib = shortlog -e --summary --numbered
    bm = branch --merged
    bn = branch --no-merged
    df = "!git hist | peco | awk '{print $2}' | xargs -I {} git diff {}^ {}"
    hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --graph --date=relative --decorate --all
    llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative
	# show number of commits per contributer, sorted
    count = shortlog -sn
	# show what I did today
    day = "!sh -c 'git log --reverse --no-merges --branches=* --date=local --after=\"yesterday 11:59PM\" --author=\"`git config --get user.name`\"'"
	# current branch
    cbr = rev-parse --abbrev-ref HEAD
	# Delete local branches that are now merged
	delete-merged-branches = "!f() { git checkout --quiet main && git branch --merged | grep --invert-match '\\*' | xargs -n 1 git branch --delete; git checkout --quiet @{-1}; }; f"
[diff]
	algorithm = histogram
	tool = nvimdiff
[github]
	user = dandxy89
[rerere]
	enabled = true
	autoUpdate = true
[push]
	autoSetupRemote = true
[pull]
    rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
[include]
	path = ~/.gitconfig.local
