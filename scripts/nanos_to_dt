#!/usr/bin/env bash
# Convert a nanosecond epoch timestamp to a readable datetime (macOS/BSD date)
set -euo pipefail

if [[ $# -ne 1 || ! $1 =~ ^[0-9]+$ ]]; then
	echo "Usage: ${0##*/} <nanotimestamp>" >&2
	exit 1
fi

echo "Nanotimestamp: $1"
echo "Datetime: $(date -r "$(($1 / 1000000000))" '+%Y-%m-%d %H:%M:%S')"
